{
  "name": "vscode-css-modules",
  "displayName": "CSS Modules: Go to Definition",
  "description": "Go to Definition from TypeScript/React into CSS Modules. Supports tsconfig path aliases and monorepos with multiple tsconfigs.",
  "version": "0.1.0",
  "private": true,
  "publisher": "katis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.com/private/vscode-css-modules"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "css modules",
    "go to definition",
    "monorepo",
    "typescript",
    "tsgo"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:typescript"
  ],
  "contributes": {},
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:prod": "node scripts/build.mjs --prod",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && mocha 'out-test/test/unit/**/*.test.js'",
    "test:integration": "npm run build && npm run compile-tests && node ./out-test/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.0.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.16.11",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.7.3"
  }
}
